{
  "manifest_version": 3,
  "name": "LeeWay Device Bridge",
  "short_name": "LeeWay Bridge",
  "version": "0.5.0",
  "description": "Authenticated LeeWay Device Bridge companion with Agent Virtual Tablet as its display. Requires approved native Device Bridge enrollment.",
  "action": {
    "default_title": "LeeWay Device Bridge",
    "default_icon": {
      "16": "icons/leeway-16.png",
      "32": "icons/leeway-32.png",
      "48": "icons/leeway-48.png",
      "128": "icons/leeway-128.png"
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "sidebar_action": {
    "default_title": "LeeWay Device Bridge",
    "default_panel": "operating-system.html",
    "default_icon": {
      "16": "icons/leeway-16.png",
      "32": "icons/leeway-32.png",
      "48": "icons/leeway-48.png",
      "128": "icons/leeway-128.png"
    }
  },
  "background": {
    "scripts": [
      "browser-polyfill.js",
      "bridge-session-contract.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/leeway-16.png",
    "32": "icons/leeway-32.png",
    "48": "icons/leeway-48.png",
    "128": "icons/leeway-128.png"
  }
}
